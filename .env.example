# Copy to .env and fill in. `npx supabase status` prints these for the local stack.
# For the local stack you can leave the URL as-is: the app rewrites localhost to your dev
# machine's LAN address on simulators, emulators and real devices automatically.
EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
EXPO_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6ImFub24iLCJleHAiOjE5ODM4MTI5OTZ9.CRXP1A7WOeoJeXxjNni43kdQwgnWNReilDMblYTn_I0

# Public origin of the web build. Invite links look like ${EXPO_PUBLIC_WEB_URL}/j/<token>.
# In production this is https://rolo.app (configured for universal links / app links).
EXPO_PUBLIC_WEB_URL=http://localhost:8081

# Store links shown on the web join page.
EXPO_PUBLIC_APP_STORE_URL=https://apps.apple.com/
EXPO_PUBLIC_PLAY_STORE_URL=https://play.google.com/store

# Only for scripts/seed.ts (never shipped in the app).
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6InNlcnZpY2Vfcm9sZSIsImV4cCI6MTk4MzgxMjk5Nn0.EGIM96RAZx35lJzdJsyH-qQwv8Hdp7fsn3W0YpN81IU
